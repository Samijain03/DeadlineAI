DEBUG=True
SECRET_KEY=replace-with-a-long-random-django-secret
# Omit DATABASE_URL for local SQLite; production uses the Neon connection secret.
DATABASE_URL=
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
GEMINI_API_KEY=
# Configure a sender for password reset. Local development can use console email.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=DeadlineAI <noreply@example.com>
# Production on Render: set EMAIL_BACKEND=api.email_backend.ResendEmailBackend
# and a private RESEND_API_KEY plus DEFAULT_FROM_EMAIL from your verified domain.
RESEND_API_KEY=
